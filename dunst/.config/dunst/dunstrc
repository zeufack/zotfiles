# Only overrides; everything else uses dunst's defaults.
# Colours come from the active theme via dunstrc.d/90-theme.conf (theme-set).
[global]
    follow = keyboard
    width = 360
    origin = top-right
    offset = (10, 50)   # clears the 42px waybar
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 0
    font = JetBrains Mono 10
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    progress_bar = true
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0
