# Only overrides; everything else uses dunst's defaults.
[global]
    follow = keyboard
    width = 360
    origin = top-right
    offset = (10, 38)
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 0
    font = JetBrains Mono 10
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    progress_bar = true
    highlight = "#78824B"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1E272B"
    foreground = "#A89F84"
    frame_color = "#2A3438"
    timeout = 4

[urgency_normal]
    background = "#1E272B"
    foreground = "#EAD49B"
    frame_color = "#9D6A47"
    timeout = 6

[urgency_critical]
    background = "#1E272B"
    foreground = "#EAD49B"
    frame_color = "#C0614E"
    timeout = 0
